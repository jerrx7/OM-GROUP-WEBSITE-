            "value": "<script>\n  /* Conversion Linker: captures GCLID from landing URL and stores it\n     in a first-party cookie for Google Ads conversion attribution. */\n  (function() {\n    try {\n      var params = new URLSearchParams(window.location.search);\n      var gclid  = params.get('gclid');\n      var gclsrc = params.get('gclsrc');\n      if (!gclid) return;\n      if (gclsrc && gclsrc.indexOf('aw') === -1) return;\n      var expiry = new Date();\n      expiry.setDate(expiry.getDate() + 90);\n      document.cookie =\n        '_gcl_aw=GCL.' + Math.floor(Date.now() / 1000) + '.' + gclid +\n        '; expires=' + expiry.toUTCString() +\n        '; path=/; SameSite=Lax';\n    } catch (e) {}\n  })();\n</script>"
